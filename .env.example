# Configuracao do Nextor. Copie para .env e ajuste. O arquivo .env NAO vai para o git.

# Nome do dispositivo exatamente como aparece no app Google Home.
NEXTOR_DISPOSITIVO=Nome do dispositivo no Google Home
# Token para proteger o servico na rede local (minimo 24 caracteres).
# Nao use 'troque-este-token'. Gere um token seguro executando:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
NEXTOR_TOKEN=gere-um-token-seguro-com-pelo-menos-24-caracteres
# Modelo local no Ollama usado como cerebro.
NEXTOR_MODELO=qwen2.5:3b
# Porta do servico local.
NEXTOR_PORTA=5005
# Ponte com o NexDeck (opcional): "no computador, bloquear" aperta o botao do deck.
# Token: o valor de data/secret.json do NexDeck.
NEXTOR_DECK_URL=
NEXTOR_DECK_TOKEN=
# Endereco privado iCal da Google Agenda (opcional). Google Agenda > Configuracoes da
# agenda > Integrar agenda > "Endereco secreto no formato iCal". E um segredo.
NEXTOR_AGENDA_ICAL=
# Fuso horario (IANA).
NEXTOR_FUSO=America/Sao_Paulo
# Seu nome (o Nextor trata voce por ele).
NEXTOR_NOME=
# Assunto padrao das noticias.
NEXTOR_NOTICIAS_ASSUNTO=inteligencia artificial generativa
# Rotina matinal: hora (HH:MM) e assunto das noticias (vazio = usa o padrao).
NEXTOR_ROTINA_HORA=07:00
NEXTOR_ROTINA_ASSUNTO=
# Persona do assistente: assistente, companheiro, profissional, amigo ou coach.
NEXTOR_PERSONA=assistente
# Cerebro: "local" (Ollama, gratis) ou "claude" (API Anthropic, pago, melhor).
NEXTOR_CEREBRO=local
# Modelo do Claude (se CEREBRO=claude). Mais barato: claude-haiku-5-5.
NEXTOR_CLAUDE_MODELO=claude-haiku-5-5
# Chave da API Anthropic (necessaria so se CEREBRO=claude). Segredo, nunca no git.
ANTHROPIC_API_KEY=
# Cerebro via agy/Maestri (se CEREBRO=agy): agente que responde.
NEXTOR_AGY_AGENTE=Claude Code
# Pasta para salvar textos (traducao/resumo/escrita). Vazio = textos/ do projeto.
# Dica: aponte para um cofre do Obsidian para ler no celular.
NEXTOR_TEXTOS_DIR=
# Gatilho fisico pelo Nest (experimental): ao levar o volume a este nivel, roda o comando.
NEXTOR_NEST_VIGIA_ACAO=
NEXTOR_NEST_VIGIA_VOLUME=100

# Modos (estudo, trabalho, tranquilidade, leitura): luzes pelo Home Assistant (opcional).
# Token de longa duracao: Perfil do usuario no Home Assistant > Tokens de acesso.
NEXTOR_HA_URL=
NEXTOR_HA_TOKEN=
# Luzes que os modos controlam, separadas por virgula. Ex.: light.quarto,light.mesa
NEXTOR_HA_LUZES=
# Ou uma cena pronta por modo (tem prioridade): NEXTOR_HA_CENA_LEITURA=scene.leitura
# Brilho da tela do notebook por modo (0-100). Padrao: leitura 30, tranquilidade 40.
# NEXTOR_BRILHO_LEITURA=30
# Desligar a mudanca de brilho da tela: NEXTOR_MODO_MUDA_PC=nao

# Voz no PC (Piper local; ver requirements-voz.txt e scripts/baixar_vozes.py).
# Idioma: pt-BR, en-US, es-ES ou fr-FR. Saida: pc, nest ou ambos.
NEXTOR_IDIOMA=pt-BR
NEXTOR_VOZ_SAIDA=pc
NEXTOR_VOZ_MOTOR=auto
# Ouvinte do microfone: segundos esperando o comando depois de "ei Nextor".
NEXTOR_JANELA_ESCUTA=8
# Bot do Telegram (opcional): assistente e modo estudante via Telegram.
# Obtenha o token com o @BotFather no Telegram.
TELEGRAM_BOT_TOKEN=
# IDs numericos de usuarios autorizados, separados por virgula. Vazio bloqueia todos.
TELEGRAM_USUARIOS_AUTORIZADOS=
# Token de adaptador do Nextor (opcional; gerado automaticamente se vazio).
TELEGRAM_ADAPTADOR_TOKEN=
# Alexa Custom Skill (opcional): skill personalizada para chamar o Nextor via Amazon Echo.
# Skill ID no formato amzn1.ask.skill.xxxx (deixe vazio para aceitar qualquer skill em dev local).
ALEXA_SKILL_ID=
# Token de adaptador do Nextor (opcional; gerado automaticamente se vazio).
ALEXA_ADAPTADOR_TOKEN=
# Verificacao criptografica de assinatura da Amazon (padrao: 1; use 0 apenas para testes locais).
ALEXA_VERIFICAR_ASSINATURA=1
# Organizador de pastas: caminhos permitidos para organizacao, separados por ponto e virgula (;).
# Se vazio, usa por padrao as pastas Downloads e Documentos da home do usuario.
NEXTOR_ORGANIZAR_PASTAS_PERMITIDAS=
# Integracao com GitHub (opcional): kanban, issues atribuidas e criacao de issues por voz.
# Token pessoal com escopo minimo (repo, read:project) gerado no GitHub.
GITHUB_TOKEN=
GITHUB_USUARIO=ThiagoVenturim
GITHUB_REPOSITORIO_PADRAO=Nextor
