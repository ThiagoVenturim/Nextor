# Configuracao do Nextor. Copie para .env e ajuste. O arquivo .env NAO vai para o git.

# Nome do dispositivo exatamente como aparece no app Google Home.
NEXTOR_DISPOSITIVO=Nome do dispositivo no Google Home
# Token para proteger o servico na rede local. Troque por um valor so seu.
NEXTOR_TOKEN=troque-este-token
# Modelo local no Ollama usado como cerebro.
NEXTOR_MODELO=qwen2.5:3b
# Porta do servico local.
NEXTOR_PORTA=5005
# Endereco privado iCal da Google Agenda (opcional). Google Agenda > Configuracoes da
# agenda > Integrar agenda > "Endereco secreto no formato iCal". E um segredo.
NEXTOR_AGENDA_ICAL=
# Fuso horario (IANA).
NEXTOR_FUSO=America/Sao_Paulo
# Seu nome (o Nextor trata voce por ele).
NEXTOR_NOME=
# Assunto padrao das noticias.
NEXTOR_NOTICIAS_ASSUNTO=inteligencia artificial generativa
# Rotina matinal: hora (HH:MM) e assunto das noticias (vazio = usa o padrao).
NEXTOR_ROTINA_HORA=07:00
NEXTOR_ROTINA_ASSUNTO=
# Persona do assistente: assistente, companheiro, profissional, amigo ou coach.
NEXTOR_PERSONA=assistente
