# Configuracao do Nextor. Copie para .env e ajuste. O arquivo .env NAO vai para o git.

# Nome do dispositivo exatamente como aparece no app Google Home.
NEXTOR_DISPOSITIVO=Nome do dispositivo no Google Home
# Token para proteger o servico na rede local (minimo 24 caracteres).
# Nao use 'troque-este-token'. Gere um token seguro executando:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
NEXTOR_TOKEN=gere-um-token-seguro-com-pelo-menos-24-caracteres
# Modelo local no Ollama usado como cerebro.
NEXTOR_MODELO=qwen2.5:3b
# Porta do servico local.
NEXTOR_PORTA=5005
# Rotas de dispositivos (pareamento, presenca, hand-off) so aceitam rede local e Tailscale.
# Redes extras de VPN privada, em CIDR separados por virgula. Ex.: 10.8.0.0/24
NEXTOR_REDES_PERMITIDAS=
# Ponte com o NexDeck (opcional): "no computador, bloquear" aperta o botao do deck.
# Token: o valor de data/secret.json do NexDeck.
NEXTOR_DECK_URL=
NEXTOR_DECK_TOKEN=
# Endereco privado iCal da Google Agenda (opcional). Google Agenda > Configuracoes da
# agenda > Integrar agenda > "Endereco secreto no formato iCal". E um segredo.
NEXTOR_AGENDA_ICAL=
# Fuso horario (IANA).
NEXTOR_FUSO=America/Sao_Paulo
# Seu nome (o Nextor trata voce por ele).
NEXTOR_NOME=
# Assunto padrao das noticias.
NEXTOR_NOTICIAS_ASSUNTO=inteligencia artificial generativa
# Rotina matinal: hora (HH:MM) e assunto das noticias (vazio = usa o padrao).
NEXTOR_ROTINA_HORA=07:00
NEXTOR_ROTINA_ASSUNTO=
# Persona do assistente: assistente, companheiro, profissional, amigo ou coach.
NEXTOR_PERSONA=assistente
# Cerebro: "local" (Ollama, gratis) ou "claude" (API Anthropic, pago, melhor).
NEXTOR_CEREBRO=local
# Modelo do Claude (se CEREBRO=claude). Mais barato: claude-haiku-5-5.
NEXTOR_CLAUDE_MODELO=claude-haiku-5-5
# Chave da API Anthropic (necessaria so se CEREBRO=claude). Segredo, nunca no git.
ANTHROPIC_API_KEY=
# Cerebro via agy/Maestri (se CEREBRO=agy): agente que responde.
NEXTOR_AGY_AGENTE=Claude Code
# Pasta para salvar textos (traducao/resumo/escrita). Vazio = textos/ do projeto.
# Dica: aponte para um cofre do Obsidian para ler no celular.
NEXTOR_TEXTOS_DIR=
# Gatilho fisico pelo Nest (experimental): ao levar o volume a este nivel, roda o comando.
NEXTOR_NEST_VIGIA_ACAO=
NEXTOR_NEST_VIGIA_VOLUME=100

# Modos (estudo, trabalho, tranquilidade, leitura): luzes pelo Home Assistant (opcional).
# Token de longa duracao: Perfil do usuario no Home Assistant > Tokens de acesso.
NEXTOR_HA_URL=
NEXTOR_HA_TOKEN=
# Luzes que os modos controlam, separadas por virgula. Ex.: light.quarto,light.mesa
NEXTOR_HA_LUZES=
# Ou uma cena pronta por modo (tem prioridade): NEXTOR_HA_CENA_LEITURA=scene.leitura
# Brilho da tela do notebook por modo (0-100). Padrao: leitura 30, tranquilidade 40.
# NEXTOR_BRILHO_LEITURA=30
# Desligar a mudanca de brilho da tela: NEXTOR_MODO_MUDA_PC=nao

# Voz no PC (Piper local; ver requirements-voz.txt e scripts/baixar_vozes.py).
# Idioma: pt-BR, en-US, es-ES ou fr-FR. Saida: pc, nest ou ambos.
NEXTOR_IDIOMA=pt-BR
NEXTOR_VOZ_SAIDA=pc
NEXTOR_VOZ_MOTOR=auto
# Ouvinte do microfone: segundos esperando o comando depois de "ei Nextor".
NEXTOR_JANELA_ESCUTA=8
# Tokens opcionais de adaptadores para /v1/assistente (se vazios, podem ser criados via API).
SIRI_ADAPTADOR_TOKEN=
GOOGLE_ADAPTADOR_TOKEN=
MCP_ADAPTADOR_TOKEN=
# Bot do Telegram (opcional): assistente e modo estudante via Telegram.
# Obtenha o token com o @BotFather no Telegram.
TELEGRAM_BOT_TOKEN=
# IDs numericos de usuarios autorizados, separados por virgula. Vazio bloqueia todos.
TELEGRAM_USUARIOS_AUTORIZADOS=
# Token de adaptador do Nextor (opcional; gerado automaticamente se vazio).
TELEGRAM_ADAPTADOR_TOKEN=
# Alexa Custom Skill (opcional): skill personalizada para chamar o Nextor via Amazon Echo.
# Skill ID no formato amzn1.ask.skill.xxxx (deixe vazio para aceitar qualquer skill em dev local).
ALEXA_SKILL_ID=
# Token de adaptador do Nextor (opcional; gerado automaticamente se vazio).
ALEXA_ADAPTADOR_TOKEN=
# Verificacao criptografica de assinatura da Amazon (padrao: 1; use 0 apenas para testes locais).
ALEXA_VERIFICAR_ASSINATURA=1
# Organizador de pastas: caminhos permitidos para organizacao, separados por ponto e virgula (;).
# Se vazio, usa por padrao as pastas Downloads e Documentos da home do usuario.
NEXTOR_ORGANIZAR_PASTAS_PERMITIDAS=
# Integracao com GitHub (opcional): kanban, issues atribuidas e criacao de issues por voz.
# Token pessoal com escopo minimo (repo, read:project) gerado no GitHub.
GITHUB_TOKEN=
GITHUB_USUARIO=ThiagoVenturim
GITHUB_REPOSITORIO_PADRAO=Nextor

# Integracao Canvas LMS (opcional - Issue #17): tarefas, prazos e avisos.
# URL base da sua instituicao (ex: https://canvas.instructure.com) e token de acesso pessoal.
CANVAS_BASE_URL=
CANVAS_TOKEN=

# Integracao Google Sala de Aula / Classroom (opcional - Issue #18): atividades, prazos e avisos.
# Token de acesso OAuth2 (em string Bearer ou caminho para arquivo token.json local).
GOOGLE_CLASSROOM_TOKEN=
# Caminho para arquivo credentials.json do Google Cloud Console (opcional, para renovacao de token).
GOOGLE_CLASSROOM_CREDENTIALS=

# Banco de dados plugavel (Issue #66 - SQLAlchemy / ODBC / PostgreSQL / MySQL / MSSQL / SQLite)
# Deixe vazio para usar SQLite local padrao (zero configuracao, ~/.nextor/gtd.db e coach.db).
# Formato: dialeto+driver://usuario:senha@host:porta/banco
# Exemplos:
#   DB_URL=postgresql+psycopg://nextor:senha@localhost:5432/nextor
#   DB_URL=mysql+pymysql://nextor:senha@localhost:3306/nextor
#   DB_URL=mssql+pyodbc://nextor:senha@localhost:1433/nextor?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#   DB_URL=sqlite:////caminho/personalizado/nextor.db
DB_URL=

# Painel GTD e Leitura (opcional - Issues #42, #43, #44)
# Caminho do banco SQLite do GTD (padrao: ~/.nextor/gtd.db)
NEXTOR_GTD_DB=
# Meta diaria de leitura em paginas (padrao: 20)
NEXTOR_LEITURA_META_DIARIA=20
# Rotina do dia usada para sugerir a ordem das tarefas (opcional). Formato:
# HH:MM-HH:MM @contexto separados por ponto e virgula. Coloque seus horarios reais so no .env.
# Ex.: NEXTOR_GTD_ROTINA=08:00-12:00 @faculdade; 13:00-18:00 @trabalho; 18:30-19:30 @academia
NEXTOR_GTD_ROTINA=
# Integracao Notion: token oficial da integracao interna (Internal Integration Secret)
NOTION_TOKEN=
# IDs das bases de dados no Notion para sincronizacao
NOTION_DB_TAREFAS=
NOTION_DB_LEITURAS=
NOTION_DB_PROJETOS=
# Webhook do GitHub para o painel GTD (opcional): segredo gerado por voce e colado tambem
# na configuracao do webhook no GitHub. Vazio desliga a rota /gtd/webhook/github.
GITHUB_WEBHOOK_SECRET=
# ID numerico do chat Telegram do dono para captura rapida no inbox
TELEGRAM_DONO_CHAT_ID=

# Notificacoes multicanal (Issue #46). Canal sem variavel fica desligado; nada quebra.
# Quais eventos vao para cada canal, canais ativos e horario de silencio ficam no painel /gtd.
# Passo a passo de cada canal: docs/NOTIFICACOES.md
# Discord, modo webhook (Configuracoes do canal > Integracoes > Webhooks):
DISCORD_WEBHOOK_URL=
# Discord, modo bot (usado so se o webhook estiver vazio): token do bot e ID numerico do canal
DISCORD_BOT_TOKEN=
DISCORD_CANAL_ID=
# WhatsApp Cloud API (opcional, exige app no Meta for Developers e conta WhatsApp Business)
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Numero de destino com DDI e DDD, so digitos
WHATSAPP_DESTINATARIO=
# Modelo aprovado com {{1}} = titulo e {{2}} = mensagem (opcional; sem ele o texto livre so
# chega se voce falou com o numero nas ultimas 24 horas)
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_IDIOMA=pt_BR
# Web Push do PWA: par de chaves VAPID em base64url (gere com: npx web-push generate-vapid-keys)
# e um e-mail de contato seu. Requer: pip install -e ".[push]"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBSCRIBER_EMAIL=
# Arquivo das inscricoes de push dos aparelhos (padrao: ~/.nextor/push_inscricoes.json)
NEXTOR_PUSH_INSCRICOES=

# Coach de estudos (Issue #57)
# Diretorio de dados e banco do coach (padrao: ~/.nextor/coach.db)
NEXTOR_COACH_DIR=
NEXTOR_COACH_DB=
# Pasta de trilhas personalizadas do usuario (padrao: ~/.nextor/trilhas)
NEXTOR_COACH_TRILHAS_DIR=

# NexRead: tradutor de artigo/pagina ao vivo com estudo (Issue #55)
# Diretorio e banco SQLite do NexRead (padrao: ~/.nextor/nexread.db)
NEXTOR_NEXREAD_DIR=
NEXTOR_NEXREAD_DB=
# Motor de traducao preferido: local (Ollama), libretranslate, nllb, opus_mt, faccoder ou claude
NEXTOR_NEXREAD_TRADUTOR=local
NEXTOR_NEXREAD_IDIOMA=pt-BR
NEXTOR_LIBRETRANSLATE_URL=http://localhost:5000/translate

# NexVoice: tradutor de audio ao vivo para videos e reunioes bidirecional (Issue #56)
# Diretorio e banco SQLite do NexVoice (padrao: ~/.nextor/nexvoice.db)
NEXTOR_NEXVOICE_DIR=
NEXTOR_NEXVOICE_DB=
# Motor STT local (faster_whisper, whisper, vosk ou stub) e tamanho do modelo Whisper
NEXTOR_NEXVOICE_STT=faster_whisper
NEXTOR_NEXVOICE_STT_MODELO=base
# Motor de traducao (local, libretranslate, nllb, opus_mt, faccoder) e TTS (piper, sapi)
NEXTOR_NEXVOICE_TRADUTOR=local
NEXTOR_NEXVOICE_TTS=piper
# Par de idiomas padrao (meu idioma <-> idioma da outra pessoa/video)
NEXTOR_NEXVOICE_IDIOMA_MEU=pt-BR
NEXTOR_NEXVOICE_IDIOMA_OUTRO=en-US
# Processamento estritamente local para proteger privacidade de voz em reunioes (true/false)
NEXTOR_NEXVOICE_LOCAL_ESTRITO=true
